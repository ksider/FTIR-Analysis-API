# Copy to .env locally. Never commit the real file.
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGIN=http://localhost:3002
REFERENCE_DIR=./references
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Disabled by default. When true, /api/analyze may use the provider/model/key
# supplied by the browser for one request via X-FTIR-LLM-* headers. The key is
# never persisted or logged by the server.
BYOK_ENABLED=false
MAX_BODY_BYTES=262144
MAX_DETECT_BODY_BYTES=8388608
DETECTOR_TIMEOUT_MS=30000
MAX_PROMPT_PEAKS_PER_SPECTRUM=80
MAX_PROMPT_CHANGES=240
LLM_MAX_OUTPUT_TOKENS=3200
LLM_TIMEOUT_MS=60000
# Production bridge to ftir-reference-service. Keep SERVICE_TOKEN out of the
# static frontend: this server sends it as X-Service-Token on its behalf.
REFERENCE_SERVICE_URL=https://ftir-reference.example.com
REFERENCE_SERVICE_TOKEN=
REFERENCE_TIMEOUT_MS=30000
MAX_REFERENCE_BODY_BYTES=8388608
RATE_LIMIT=20
RATE_WINDOW_MS=60000
