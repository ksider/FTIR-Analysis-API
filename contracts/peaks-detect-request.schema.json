{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftir.example/schemas/peaks-detect-request.schema.json",
  "title": "FTIR peak detection request",
  "type": "object",
  "required": ["schemaVersion", "spectra", "settings"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "spectra": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/spectrum" }
    },
    "settings": { "$ref": "#/$defs/detectionSettings" }
  },
  "$defs": {
    "spectrum": {
      "type": "object",
      "required": ["id", "name", "signalType", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sourceFile": { "type": "string", "maxLength": 255 },
        "role": { "type": "string", "enum": ["before", "after", "control", "repeat", "unknown"] },
        "signalType": { "type": "string", "enum": ["transmittance", "absorbance", "intensity", "unknown"] },
        "xUnit": { "const": "cm-1" },
        "yUnit": { "type": "string", "maxLength": 40 },
        "points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 500000,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "detectionSettings": {
      "type": "object",
      "properties": {
        "smoothingMethod": { "type": "string", "enum": ["none", "moving_average", "savgol"] },
        "smoothingWindow": { "type": "integer", "minimum": 1, "maximum": 101 },
        "baselineMethod": { "type": "string", "enum": ["none", "linear", "arpls", "airpls", "asls", "snip", "rubberband"] },
        "baselineDegree": { "type": "integer", "minimum": 1, "maximum": 8 },
        "broadProminenceWindowCm1": { "type": "number", "minimum": 50, "maximum": 2000 },
        "broadSmoothingWindow": { "type": "integer", "minimum": 3, "maximum": 101 },
        "broadMinSeparationCm1": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "broadBaselineMethod": { "type": "string", "enum": ["linear", "none"] },
        "crossEngineMergeCm1": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "baselineLambda": { "type": "number", "minimum": 1, "maximum": 1000000000000 },
        "baselineAsymmetry": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "baselineSnipWindowCm1": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "minProminence": { "type": "number", "minimum": 0 },
        "minSeparationCm1": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "minWidthCm1": { "type": "number", "minimum": 0 },
        "maxWidthCm1": { "type": "number", "exclusiveMinimum": 0 },
        "maxPeaks": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  },
  "additionalProperties": false
}
